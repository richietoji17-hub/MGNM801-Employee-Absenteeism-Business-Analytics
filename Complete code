)

plt.bar(
    x + width / 2,
    rf_values,
    width,
    label="Random Forest"
)

plt.xticks(
    x,
    metrics_to_plot
)

plt.ylabel("Score")
plt.ylim(0, 1)
plt.title("Figure 7: Classification Model Performance Comparison")
plt.legend()
plt.tight_layout()

plt.savefig(
    "charts/figure_7_model_comparison.png",
    dpi=220,
    bbox_inches="tight"
)

plt.show()

print("\nOUTPUT – STEP 27 / FIGURE 7")
print("----------------------------")
print(
    "The model-performance chart compares accuracy, precision, recall, "
    "F1-score and AUC for the two models."
)


# ============================================================
# STEP 28 – CLASSIFICATION REPORT
# ============================================================

classification_results = classification_report(
    y_test,
    best_pred,
    target_names=[
        "Lower Absenteeism",
        "Higher Absenteeism"
    ],
    zero_division=0
)

print("\nOUTPUT – STEP 28")
print("-----------------")
print(classification_results)

